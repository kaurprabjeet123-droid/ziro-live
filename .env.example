# OAuth — fill these in Vercel > Settings > Environment Variables.
# NEVER commit real values. Never put secrets in code or in chat.
# The *_SECRET values must ONLY be server env vars (no VITE_ prefix).
# The client/app IDs are public identifiers (like a username) — they
# are safe to expose in the browser, which is why they also have a
# VITE_ copy below. The secret is what must stay hidden.
# Google Cloud: project "ziro", OAuth client (Web application)
# Redirect URI registered in Google Cloud:
#   https://ziro.site/signin/google/cb
# To test on the Vercel preview link first, also add this exact
# redirect URI in Google Cloud (Authorized redirect URIs):
#   https://<your-project>.vercel.app/signin/google/cb
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# NOTE: there is NO VITE_GOOGLE_CLIENT_ID. The browser fetches the
# public client ID at run time from /api/auth/config (see
# api/auth/config.js), so it must never be baked in at build time.

# Meta for Developers: app "ziro", Facebook Login
# Valid OAuth Redirect URI registered in Facebook:
#   https://ziro.site/signin/fb/cb
# To test on the Vercel preview link first, also add:
#   https://<your-project>.vercel.app/signin/fb/cb
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# NOTE: there is NO VITE_FACEBOOK_APP_ID, for the same reason —
# the browser fetches it at run time from /api/auth/config.

# Public site URL (used for OAuth return links in the UI)
VITE_SITE_URL=https://ziro.site
