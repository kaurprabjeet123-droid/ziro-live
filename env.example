# OAuth — fill these in Vercel > Settings > Environment Variables.
# NEVER commit real values. Never put secrets in code or in chat.
# Google Cloud: project "ziro", OAuth client (Web application)
# Redirect URI registered in Google Cloud:
#   https://ziro.site/signin/google/cb
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta for Developers: app "ziro", Facebook Login
# Valid OAuth Redirect URI registered in Facebook:
#   https://ziro.site/signin/fb/cb
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Public site URL (used for OAuth return links in the UI)
VITE_SITE_URL=https://ziro.site
